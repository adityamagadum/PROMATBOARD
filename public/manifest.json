{
  "manifest_version": 3,
  "name": "PromptVault",
  "short_name": "PromptVault",
  "version": "1.0.0",
  "description": "A beautiful, fast prompt library. Name, organise and copy your prompts for ChatGPT, Claude, Gemini and Midjourney in one click.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PromptVault (Ctrl+Shift+Y)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "app.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Open PromptVault"
    },
    "open-side-panel": {
      "suggested_key": { "default": "Alt+Shift+Y", "mac": "Alt+Shift+Y" },
      "description": "Open PromptVault in the side panel"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "sidePanel",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "minimum_chrome_version": "116"
}
